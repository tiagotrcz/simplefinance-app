# .env do deploy na VM (docker-compose.vps.yml). Fica só na VM, com chmod 600. Nunca no repositório.
# Gere os segredos na própria VM:
#   POSTGRES_PASSWORD      openssl rand -hex 24      (vale só no primeiro boot: fica gravada no volume)
#   JWT_SIGNING_KEY        openssl rand -base64 64 | tr -d '\n'
#   TOTP_ENCRYPTION_KEY    openssl rand -base64 32   (diferente da chave do JWT)
#   PLUGGY_WEBHOOK_SECRET  openssl rand -hex 32

# Versão das imagens no GHCR (a tag do release).
TAG=v1.0.0
# Opcional: padrão saveme.harpialab.com.
# DOMAIN=

POSTGRES_PASSWORD=
JWT_SIGNING_KEY=
TOTP_ENCRYPTION_KEY=

# Pluggy Dashboard -> Applications. Com o conector MeuPluggy, uso pessoal é grátis.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=

# Opcional: alertas pelo Telegram (@BotFather -> /newbot; chat id em /bot<token>/getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: IA. Vem desligada; as chaves também podem ser definidas em Configurações -> IA.
AI_DEEPSEEK_API_KEY=
AI_OPENAI_API_KEY=
AI_ANTHROPIC_API_KEY=
AI_OPENROUTER_API_KEY=
